# Copy this file to .env and replace every CHANGE_ME value before first use.
# Never commit .env or reuse these example values on a shared deployment.

A2Z_SECRET_KEY=CHANGE_ME_WITH_A_UNIQUE_RANDOM_VALUE
A2Z_ADMIN_PASSWORD=CHANGE_ME_WITH_A_LONG_UNIQUE_ADMIN_PASSWORD

# Create the initial branch and equipment catalogue on a new database.
A2Z_SEED_REFERENCE_DATA=1

# Sample people are for disposable demonstrations only. Keep both at 0 for real use.
A2Z_SEED_DEMO_DATA=0
A2Z_SEED_DEMO_STUDENT=0
# Clients contact staff to arrange slots. Keep this legacy self-booking switch off.
A2Z_STUDENT_SELF_BOOKING=0
# If you deliberately enable them, uncomment and replace both passwords first.
# A2Z_INSTRUCTOR_PASSWORD=CHANGE_ME_ONLY_IF_ENABLING_DEMO_DATA
# A2Z_STUDENT_PASSWORD=CHANGE_ME_ONLY_IF_ENABLING_DEMO_DATA

# Use an absolute path on an always-on host, preferably outside a synced folder.
# Example: A2Z_DATABASE=C:\A2Z\data\a2z_booking.db
A2Z_DATABASE=./a2z_booking.db

# Local HTTP: 0. Any HTTPS tunnel, proxy or managed HTTPS deployment: 1.
A2Z_SECURE_COOKIES=0

# Automated confirmations and reminders use one preferred channel per client.
# Leave the worker disabled until at least one provider below is configured.
A2Z_ENABLE_NOTIFICATIONS=0
# A2Z_SMTP_HOST=smtp.example.com
# A2Z_SMTP_PORT=587
# A2Z_SMTP_SECURITY=starttls
# A2Z_SMTP_USERNAME=
# A2Z_SMTP_PASSWORD=
# A2Z_SMTP_FROM=appointments@example.com
# A2Z_SMS_WEBHOOK_URL=https://sms-provider.example/send
# A2Z_SMS_WEBHOOK_TOKEN=

# These settings apply only to direct `python wsgi.py` development runs.
# The start-local.ps1 launcher uses Waitress and its own Listen/Port parameters.
A2Z_HOST=127.0.0.1
PORT=5000
A2Z_DEBUG=0
